PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/agency-discovery
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
VITE_API_URL=http://localhost:5000/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GITHUB_TOKEN=your_github_token
LOGO_DEV_TOKEN=your_logo_dev_token
CACHE_CRON=
CACHE_TIMEZONE=UTC
# Optional normalized weights. Gemini never calculates ranking scores.
RANKING_WEIGHTS={"reputation":0.30,"serviceMatch":0.20,"technologyMatch":0.10,"portfolioQuality":0.10,"companyMaturity":0.10,"profileCompleteness":0.10,"userEngagement":0.05,"recentActivity":0.05}
